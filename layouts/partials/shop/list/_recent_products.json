{
  "meta": {
    "is_partial": true,
    "description": "최근 본 상품 섹션. 데이터소스 이름에 직접 결합하지 않고 부모 레이아웃이 정의한 $computed.recentItems 를 읽는다 (다른 화면이 재사용해도 섹션이 조용히 비지 않는다)"
  },
  "type": "basic",
  "name": "Div",
  "if": "{{($computed.recentItems ?? []).length > 0}}",
  "isolatedState": {
    "scrollIdx": 0
  },
  "isolatedScopeId": "recent-products-scroll",
  "props": { "className": "mb-12" },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "flex justify-between items-center mb-4" },
      "children": [
        {
          "type": "basic",
          "name": "H2",
          "props": { "className": "text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "clock", "className": "text-xl" } },
            { "type": "basic", "name": "Span", "text": "$t:shop.recent_products" }
          ]
        },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "flex gap-2" },
          "children": [
            {
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "{{_isolated.scrollIdx <= 0 ? 'p-2 border border-gray-200 dark:border-gray-700 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'p-2 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700'}}",
                "disabled": "{{_isolated.scrollIdx <= 0}}"
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "sequence",
                  "actions": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "isolated",
                        "scrollIdx": "{{_isolated.scrollIdx - 1}}"
                      }
                    },
                    {
                      "handler": "scrollIntoView",
                      "params": {
                        "selector": "#recent-product-{{_isolated.scrollIdx}}",
                        "behavior": "smooth",
                        "inline": "start",
                        "waitForElement": true,
                        "timeout": 1000
                      }
                    }
                  ]
                }
              ],
              "children": [{ "type": "basic", "name": "Icon", "props": { "name": "chevron-left", "className": "text-base" } }]
            },
            {
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "{{(_isolated.scrollIdx + 4) >= (($computed.recentItems ?? []).length) ? 'p-2 border border-gray-200 dark:border-gray-700 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'p-2 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700'}}",
                "disabled": "{{(_isolated.scrollIdx + 4) >= (($computed.recentItems ?? []).length)}}"
              },
              "responsive": {
                "0-639": {
                  "props": {
                    "className": "{{(_isolated.scrollIdx + 2) >= (($computed.recentItems ?? []).length) ? 'p-2 border border-gray-200 dark:border-gray-700 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'p-2 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700'}}",
                    "disabled": "{{(_isolated.scrollIdx + 2) >= (($computed.recentItems ?? []).length)}}"
                  }
                },
                "640-1023": {
                  "props": {
                    "className": "{{(_isolated.scrollIdx + 3) >= (($computed.recentItems ?? []).length) ? 'p-2 border border-gray-200 dark:border-gray-700 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed' : 'p-2 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700'}}",
                    "disabled": "{{(_isolated.scrollIdx + 3) >= (($computed.recentItems ?? []).length)}}"
                  }
                }
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "sequence",
                  "actions": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "isolated",
                        "scrollIdx": "{{_isolated.scrollIdx + 1}}"
                      }
                    },
                    {
                      "handler": "scrollIntoView",
                      "params": {
                        "selector": "#recent-product-{{_isolated.scrollIdx}}",
                        "behavior": "smooth",
                        "inline": "start",
                        "waitForElement": true,
                        "timeout": 1000
                      }
                    }
                  ]
                }
              ],
              "children": [{ "type": "basic", "name": "Icon", "props": { "name": "chevron-right", "className": "text-base" } }]
            }
          ]
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "grid grid-flow-col auto-cols-[calc(50%_-_8px)] sm:auto-cols-[calc(33.333%_-_11px)] lg:auto-cols-[calc(25%_-_12px)] gap-4 overflow-x-hidden" },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "iteration": { "source": "{{$computed.recentItems ?? []}}", "item_var": "product", "index_var": "idx" },
          "props": {
            "id": "recent-product-{{idx}}"
          },
          "children": [
            { "type": "composite", "name": "ProductCard", "props": { "product": "{{product}}", "shopBase": "{{_global.shopBase ?? '/shop'}}" } }
          ]
        }
      ]
    }
  ]
}