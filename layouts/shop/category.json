{
    "version": "1.0.0",
    "layout_name": "shop/category",
    "permissions": [],
    "extends": "_user_base",
    "computed": {
        "gridProducts": "{{storefront?.data?.products?.data ?? []}}",
        "gridPagination": "{{storefront?.data?.products?.pagination ?? null}}"
    },
    "meta": {
        "title": "{{storefront?.data?.category?.name_localized ?? $t:shop.categories}}",
        "description": "{{storefront?.data?.category?.description_localized ?? ''}}",
        "seo": {
            "enabled": true,
            "extensions": [
                { "type": "module", "id": "sirsoft-ecommerce" }
            ],
            "data_sources": ["storefront"],
            "page_type": "category",
            "toggle_setting": "$module_settings:sirsoft-ecommerce:seo.seo_category",
            "vars": {
                "category_name": "{{storefront?.data?.category?.name ?? ''}}",
                "category_description": "{{storefront?.data?.category?.description ?? ''}}",
                "site_name": "$core_settings:general.site_name",
                "shopBase": "$module_settings:sirsoft-ecommerce:basic_info.route_path"
            },
            "priority": 0.6,
            "changefreq": "weekly",
            "og": {
                "type": "website",
                "title": "{{_seo.category.title ?? storefront?.data?.category?.name ?? ''}}",
                "description": "{{_seo.category.description ?? storefront?.data?.category?.description ?? ''}}"
            },
            "structured_data": {
                "@type": "ItemList",
                "name": "{{_seo.category.title ?? storefront?.data?.category?.name ?? ''}}"
            }
        }
    },
    "data_sources": [
        {
            "id": "storefront",
            "label_key": "$t:editor.data_source.storefront",
            "comment": "보고 있는 분류와 그 분류의 상품 목록을 한 번에 받는다. 종전에는 분류·분류트리·상품목록으로 요청이 3번 나갔고, 그중 분류트리는 이 화면의 어떤 표현식도 읽지 않는 낭비였다. 각 묶음의 응답 형태는 개별 엔드포인트와 동일하다.",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/storefront",
            "method": "GET",
            "auth_mode": "optional",
            "params": {
                "page": "{{query.page ?? 1}}",
                "per_page": 12,
                "category_slug": "{{route.slug}}",
                "sort": "{{query.sort ?? 'latest'}}",
                "search": "{{query.keyword ?? ''}}",
                "popular_limit": 0,
                "new_limit": 0
            },
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": {
                    "category": null,
                    "products": {
                        "data": [],
                        "pagination": {
                            "current_page": 1,
                            "last_page": null,
                            "per_page": 12,
                            "total": 0,
                            "has_more_pages": false
                        }
                    }
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "type": "layout",
                "name": "Container",
                "props": {
                    "className": "py-8"
                },
                "children": [
                    {
                        "comment": "카테고리 헤더",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mb-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2"
                                },
                                "children": [
                                    {
                                        "comment": "뒤로가기: 상위 카테고리 있으면 상위로, 없으면 /shop으로",
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "className": "p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Icon",
                                                "props": { "name": "arrow-left", "className": "text-xl" }
                                            }
                                        ],
                                        "actions": [
                                            {
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "{{(storefront?.data?.category?.breadcrumb ?? []).length > 1 ? _global.shopBase + '/category/' + (storefront?.data?.category?.breadcrumb ?? []).slice(-2, -1)[0]?.slug : _global.shopBase + '/products'}}"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "{{storefront?.data?.category?.name_localized ?? $t:shop.categories}}"
                                    }
                                ]
                            },
                            {
                                "comment": "설명 + 브레드크럼 한 줄",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center justify-between mt-1"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "if": "{{!!storefront?.data?.category?.description_localized}}",
                                        "props": {
                                            "className": "text-gray-600 dark:text-gray-400"
                                        },
                                        "text": "{{storefront?.data?.category?.description_localized ?? ''}}"
                                    },
                                    {
                                        "comment": "브레드크럼 (전체 > 경로 > 현재)",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "A",
                                                "props": {
                                                    "href": "{{_global.shopBase}}/products",
                                                    "className": "hover:text-gray-700 dark:hover:text-gray-300"
                                                },
                                                "text": "$t:shop.category.all"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "iteration": {
                                                    "source": "{{storefront?.data?.category?.breadcrumb ?? []}}",
                                                    "item_var": "crumb"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "flex items-center gap-1"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Icon",
                                                                "props": {
                                                                    "name": "chevron-right",
                                                                    "className": "text-xs"
                                                                }
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "A",
                                                                "if": "{{crumb.slug !== route.slug}}",
                                                                "props": {
                                                                    "href": "{{_global.shopBase}}/category/{{crumb.slug}}",
                                                                    "className": "hover:text-gray-700 dark:hover:text-gray-300"
                                                                },
                                                                "text": "{{crumb.name}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "if": "{{crumb.slug === route.slug}}",
                                                                "props": {
                                                                    "className": "text-gray-900 dark:text-white font-medium"
                                                                },
                                                                "text": "{{crumb.name}}"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "comment": "카테고리 배너 이미지",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{(storefront?.data?.category?.images ?? []).length > 0}}",
                        "props": {
                            "className": "mb-6 rounded-lg overflow-hidden"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Img",
                                "props": {
                                    "src": "{{storefront?.data?.category?.images?.[0]?.download_url ?? ''}}",
                                    "alt": "{{storefront?.data?.category?.images?.[0]?.alt_text ?? storefront?.data?.category?.name_localized ?? ''}}",
                                    "className": "w-full h-auto object-cover max-h-64"
                                }
                            }
                        ]
                    },
                    {
                        "comment": "검색 바",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "flex gap-2 mb-4" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Input",
                                "props": {
                                    "type": "text",
                                    "name": "keyword",
                                    "placeholder": "$t:shop.search_placeholder",
                                    "className": "flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white",
                                    "value": "{{_local.keyword ?? query.keyword ?? ''}}"
                                },
                                "actions": [
                                    {
                                        "type": "change",
                                        "handler": "setState",
                                        "params": { "target": "local", "keyword": "{{$event.target.value}}" }
                                    },
                                    {
                                        "type": "keydown",
                                        "handler": "navigate",
                                        "key": "Enter",
                                        "params": {
                                            "path": "{{route.path}}",
                                            "mergeQuery": true,
                                            "query": {
                                                "keyword": "{{_local.keyword ?? ''}}",
                                                "page": "1"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": { "className": "px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium" },
                                "text": "$t:shop.search",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "{{route.path}}",
                                            "mergeQuery": true,
                                            "query": {
                                                "keyword": "{{_local.keyword ?? query.keyword ?? ''}}",
                                                "page": "1"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "comment": "하위 카테고리 칩 (자식 카테고리가 있을 때만 표시)",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{(storefront?.data?.category?.children ?? []).length > 0}}",
                        "props": { "className": "flex flex-wrap gap-2 mb-4" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "iteration": { "source": "{{storefront?.data?.category?.children ?? []}}", "item_var": "sub" },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "className": "px-3 py-1.5 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-full text-sm hover:bg-gray-100 dark:hover:bg-gray-600"
                                        },
                                        "text": "{{sub?.name_localized}}",
                                        "actions": [
                                            { "comment": "audit:allow layout-list-context-navigate-merge-query 하위 카테고리 이동 — 다른 목록으로의 이동이라 상위 카테고리의 검색·정렬·페이지를 승계하지 않는다", "type": "click", "handler": "navigate", "params": { "path": "{{_global.shopBase}}/category/{{sub?.slug}}" } }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "comment": "정렬 바",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "flex items-center justify-between py-3 bg-gray-50 dark:bg-gray-800/50"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "text-sm font-semibold text-gray-700 dark:text-gray-300"
                                },
                                "text": "$t:shop.total_count|count={{storefront?.data?.products?.pagination?.total ?? 0}}"
                            },
                            {
                                "type": "composite",
                                "name": "Select",
                                "props": {
                                    "name": "sort",
                                    "value": "{{query.sort ?? 'latest'}}",
                                    "className": "h-9 w-32",
                                    "options": [
                                        { "value": "latest", "label": "$t:shop.sort.latest" },
                                        { "value": "sales", "label": "$t:shop.sort.sales" },
                                        { "value": "price_asc", "label": "$t:shop.sort.price_asc" },
                                        { "value": "price_desc", "label": "$t:shop.sort.price_desc" }
                                    ]
                                },
                                "actions": [
                                    {
                                        "type": "change",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "{{route.path}}",
                                            "mergeQuery": true,
                                            "query": {
                                                "sort": "{{$event.target.value}}",
                                                "page": "1"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "partial": "partials/shop/list/_product_grid.json"
                    }
                ]
            }
        ]
    }
}